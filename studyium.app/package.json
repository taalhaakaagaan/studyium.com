{
  "name": "studyium.app",
  "version": "0.4.0",
  "description": "Studyium Desktop Application",
  "author": {
    "name": "Talha Kağan Tosun",
    "email": "talhazor1@gmail.com"
  },
  "homepage": "https://github.com/taalhaakaagaan/studyium.com",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron-build": "next build && electron-builder"
  },
  "build": {
    "appId": "com.studyium.app",
    "productName": "Studyium",
    "publish": [
      {
        "provider": "github",
        "owner": "taalhaakaagaan",
        "repo": "studyium.com"
      }
    ],
    "files": [
      "out/**/*",
      "main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "extraFiles": [
      {
        "from": "C:/Windows/System32/vcruntime140.dll",
        "to": "."
      },
      {
        "from": "C:/Windows/System32/vcruntime140_1.dll",
        "to": "."
      },
      {
        "from": "C:/Windows/System32/msvcp140.dll",
        "to": "."
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.27.2",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.16.1",
    "next": "16.1.4",
    "nodemailer": "^7.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mysql": "^2.15.27",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}